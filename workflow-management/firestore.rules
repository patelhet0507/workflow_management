rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && role() in ['admin', 'super_admin'];
    }

    function isSuperAdmin() {
      return signedIn() && role() == 'super_admin';
    }

    // ---- Users ----
    // Signed-in user may read/write only their own profile.
    // Role can never be self-promoted: self-registration is locked to the lowest
    // role (data_entry); only an admin may set or change any other role.
    // NOTE: the first admin/super_admin must be promoted manually (console or
    // script), because nobody can self-bootstrap the admin role.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && (isAdmin() || (request.auth.uid == uid && request.resource.data.role == 'data_entry'));
      allow update: if signedIn() && (isAdmin() || (request.auth.uid == uid && request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }

    // ---- Config (approval flow) ----
    // Read by everyone signed-in (booking pages render the flow); write is admin only.
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- Bookings ----
    // Everyone signed-in reads; data_entry + admin creates; any workflow role
    // updates (approve/reject writes status + approval doc).
    // ponytail: status transitions are enforced in app code (api.approveBooking),
    // not in rules. Add rules-side stage validation (read config/approval_flow
    // and check role() matches) if client-side bypass becomes a real risk.
    match /bookings/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && role() in ['data_entry', 'admin', 'super_admin'];
      allow update: if signedIn();
      allow delete: if isSuperAdmin();

      // Approval history: anyone signed-in appends; admin can edit/delete.
      match /approvals/{aId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update, delete: if isAdmin();
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
